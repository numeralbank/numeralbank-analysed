left_join(doculects.good, join_by(FileName == File)) %>%
filter(Use_in_analyses == "YES") -> data.glossed.filtered
data.glossed.checked.merged %>%
left_join(doculects.good, join_by(FileName == File)) %>%
filter(Use_in_analyses == "YES") -> data.glossed.checked.filtered
table(doculects.good$Use_in_analyses)
length(unique(data.glossed.filtered$FileName))
length(unique(data.glossed.checked.filtered$FileName))
# 4856 doculects
# 5048 if all.data.glossed.csv
write.csv(data.glossed.filtered, "data.glossed.filtered.csv")
write.csv(data.glossed.checked.filtered, "data.glossed.checked.filtered.csv")
#check mismatches between glossed and checked
data.glossed.merged %>%
filter(!(FileName %in% data.glossed.checked$FileName)) -> problematic.glossed
###
