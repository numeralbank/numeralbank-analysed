# Gloss = str_replace_all(Gloss,"\\.", "⋅"), NOT! THERE IS 12.5 IN MESOAMERICAN LANGUAGES
Gloss = str_replace_all(Gloss,"∙", "⋅"),
Gloss = str_replace_all(Gloss,"-", "−"),
Gloss = str_replace_all(Gloss,"’", "′"),
