mutate(Gloss.math = gsub("\\(([0-9]+)\\+([0-9]+)\\+([0-9]+)\\)","\\1\\+\\2\\+\\3",Gloss.math)) %>% #(n+m+q)
mutate(Gloss.math = gsub("\\(([0-9]+)⋅([0-9]+)⋅([0-9]+)\\)","\\1⋅\\2⋅\\3",Gloss.math)) %>% #(n⋅m⋅q)
mutate(Gloss.math = gsub("\\(\\(([0-9]+)\\+([0-9]+)\\)⋅([0-9]+)\\)","\\(\\1\\+\\2\\)⋅\\3",Gloss.math)) %>% #((n+m)⋅q)
mutate(Gloss.math = gsub("\\(([0-9]+)⋅\\(([0-9]+)\\+([0-9]+)\\)\\)","\\1⋅\\(\\2\\+3\\)",Gloss.math)) %>% #(q⋅(n+m))
mutate(Gloss.math = gsub("\\(\\(([0-9]+)−([0-9]+)\\)⋅([0-9]+)\\)","\\(\\1−\\2\\)⋅\\3",Gloss.math)) %>% #((n−m)⋅q)
mutate(Gloss.math = gsub("\\(([0-9]+)⋅\\(([0-9]+)−([0-9]+)\\)\\)","\\1⋅\\(\\2−3\\)",Gloss.math)) %>% #(q⋅(n−m))
