#extra columns
colnames(merged)[!(colnames(merged) %in% colnames(all.data))]
ncol(merged)
for(i in 1:length(files_char)){
colnames(files_char[[i]]) <- sub("^X\\.", "", colnames(files_char[[i]]))
colnames(files_char[[i]]) <- sub("\\.$", "", colnames(files_char[[i]]))
}
