write.csv(orthography.words.profile,"orthography.profile.csv")
all.data %>%
mutate(splitGloss = strsplit(Gloss,split="")) %>%
dplyr::select(splitGloss) %>%
unlist() %>%
as.data.frame() ->all.characters.symbol
